{
    "connection": {
        "host": "localhost",
        "port": 5672,
        "username": "guest",
        "password": "guest",
        "virtual_host": "/",
        "connection_attempts": 3,
        "retry_delay": 2.0
    },
    "queues": {
        "web_extract": {
            "queue": "Swagman/WebExtract",
            "virtual_host": "/",
            "durable": true
        },
        "local_AI": {
            "queue": "Ollama/LocalAI",
            "virtual_host": "/",
            "durable": true
        },
        "fallback": {
            "queue": "Kelpie/Fallback",
            "virtual_host": "/",
            "durable": true
        }
    },
    "consumers": {
        "web_extract": {
            "module": "Swagman.queue_consumer",
            "drain": "drain",
            "queue_key": "web_extract"
        },
        "local_AI": {
            "module": "Tasks.local_ai_consumer",
            "drain": "drain",
            "queue_key": "local_AI"
        },
        "fallback": {
            "module": "Tasks.fallback_consumer",
            "drain": "drain",
            "queue_key": "fallback"
        }
    }
}
